# Alexandria Library - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE - Supabase REST API (Recommended)
# ============================================================================
# Get these from: Supabase Dashboard → Settings → API
# This is the RECOMMENDED approach - no connection string issues!

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=waleeds-library

# Local development reads PDFs directly from the SSD. Production leaves this
# unset and uses private object storage instead.
LOCAL_PDF_ROOT=/Volumes/Extreme SSD/Downloads/Librarai/alexandria/batch1books
LIBRARY_CATALOG_PATH=library/catalog.json
PDF_SIGNED_URL_TTL=900
# The signed-in reader finder is part of the public product. Set false only
# when temporarily disabling it for maintenance or incident response.
SOURCE_FINDER_ENABLED=true

# ============================================================================
# SECRETS
# ============================================================================

# Session secret key (generate with: openssl rand -hex 32)
# CRITICAL: Change this in production!
SECRET_KEY=your-secret-key-change-in-production

# Environment mode
# Options: development, production
ENV=development
PUBLIC_BASE_URL=https://libxndr.com
# Enable only after Google is configured in Supabase and the LibXNDR callback is allowlisted.
GOOGLE_AUTH_ENABLED=false

# ============================================================================
# LLM (Optional - App works without these in mock mode)
# ============================================================================

# OpenAI API key for LLM-powered agents
# If not set: agents run in mock/keyword mode
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Use mock agents instead of LLM (faster, no API costs)
# Options: true, false
USE_MOCK_AGENTS=true

# Enable debug mode (verbose logging)
# Options: true, false
DEBUG=true

# ============================================================================
# SESSION SETTINGS
# ============================================================================

# Cookie name is fixed to __session for Firebase Hosting compatibility.

# Session max age in seconds (default: 7 days)
SESSION_MAX_AGE=604800

# ============================================================================
# RATE LIMITING
# ============================================================================

# Ask endpoint: requests per minute
RATE_LIMIT_ASK=10

# Chat endpoint: requests per minute
RATE_LIMIT_CHAT=30

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# LOCAL DEVELOPMENT (SQLite Fallback)
# ============================================================================
# If SUPABASE_URL is NOT set, the app falls back to SQLite.
# This is useful for local development without internet.
# 
# To use SQLite: Just don't set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY

# ============================================================================
# NOTES
# ============================================================================
#
# 1. NEVER commit .env to git (it's in .gitignore)
#
# 2. In production, set secrets on the Cloud Run service, not in the browser.
#    - Vercel: Settings → Environment Variables
#
# 3. Get Supabase credentials:
#    - Go to: https://supabase.com/dashboard
#    - Select your project
#    - Go to Settings → API
#    - Copy "Project URL" → SUPABASE_URL
#    - Copy "service_role key" (NOT anon key!) → SUPABASE_SERVICE_ROLE_KEY
#
# 4. The service_role key bypasses Row Level Security (RLS)
#    Only use it server-side, NEVER expose to frontend
#
# 5. Test with USE_MOCK_AGENTS=true before enabling LLM
